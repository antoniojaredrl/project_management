<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="plantas_obra_views_form" model="ir.ui.view">
        <field name="name">plantas.obra.form</field>
        <field name="model">plantas.obra</field>
        <field name="arch" type="xml">
            <form string="Plantas Obra">
                <sheet>
                    <group>
                        <group>
                            <field name="nombre_planta" />
                        </group>

                        <group>
                            <field name="cliente_rela" />
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="plantas_obra_views_list" model="ir.ui.view">
        <field name="name">Plantas</field>
        <field name="model">plantas.obra</field>
        <field name="arch" type="xml">
            <list string="Plantas" editable="bottom">
                <field name="nombre_planta"/>
                <field name="cliente_rela"/>
            </list>
        </field>
    </record>

    <record id="plantas_obra_action" model="ir.actions.act_window">
        <field name="name">Plantas</field>
        <field name="res_model">plantas.obra</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primer registro
            </p>
        </field>
    </record>
</odoo>