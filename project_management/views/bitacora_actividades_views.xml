<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="bitacora_actividades_views_form" model="ir.ui.view">
        <field name="name">bitacora.actividades.form</field>
        <field name="model">bitacora.actividades</field>
        <field name="arch" type="xml">
            <form string="Bitacora Actividades">
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>

                    <group string="Información Relacional" >
                        <field name="task_id" />
                    </group>

                    <group>
                        <group>
                            <field name="project_id" />
                            <field name="cliente" />
                        </group>

                        <group>
                            <field name="sale_order_id" />
                            <field name="especialidad_venta" widget="many2many_tags"/>
                        </group>
                    </group>

                    <group string="Datos Generales">
                        <group>
                            <field name="oc_pedido" />
                            <field name="centro_trabajo" />
                            <field name="especialidad_trabajo" />
                        </group>

                        <group>
                            <field name="fecha_creacion" widget="datetime" />
                            <field name="or_rfq" />
                            <field name="no_cotizacion" />
                        </group>
                    </group>

                    <group string="Descripción Detallada del Trabajo">
                        <group>
                            <field name="hora_inicio" />
                            <field name="planta_trabajo" />
                            <field name="supervisor_ayasa" widget="many2one_avatar" />
                        </group>

                        <group>
                            <field name="hora_termino" />
                            <field name="licencia_om" />
                            <field name="supervisor_cliente" widget="many2one_avatar" />
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="bitacora_actividades_views_list" model="ir.ui.view">
        <field name="name">bitacora.actividades.list</field>
        <field name="model">bitacora.actividades</field>
        <field name="arch" type="xml">
            <list string="Bitacora Actividades">
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="bitacora_actividades_action" model="ir.actions.act_window">
        <field name="name">Bitacora Actividades</field>
        <field name="res_model">bitacora.actividades</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primer registro
            </p>
        </field>
    </record>
</odoo>