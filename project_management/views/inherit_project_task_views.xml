<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="inherit_project_task_view_form" model="ir.ui.view">
        <field name="name">project.task.inherit.form</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='role_ids']" position="after">
                <field  name="es_tarea_obra" widget="boolean_toggle"/>
            </xpath>

            <xpath expr="//notebook" position="before">
                <group string="Datos Generales" invisible="not es_tarea_obra">
                    <group>
                        <field name="fecha_creacion" />
                        <field name="disciplina" widget="many2one" />
                        <field name="area_trabajo" />
                        <field name="supervisor_int" widget="many2one_avatar_employee" />
                    </group>

                    <group>
                        <field name="cliente" />
                        <field name="planta" widget="many2one" />
                        <field name="licencia_om" />
                        <field name="supervisor_ext" widget="many2one_avatar" />
                    </group>
                </group>
                <group string="Ejecución Operativa" invisible="not es_tarea_obra">
                    <group>
                        <field name="producto"/>
                        <field name="valor_uni" />
                    </group>

                    <group>
                        <field name="cantidad_sol" />
                        <field name="valor_total" />
                    </group>
                </group>
                <group string="Avance" invisible="not es_tarea_obra">
                    <group>
                        <field name="cantidad_entregada" />
                        <field name="cantidad_pendiente" />
                    </group>
                    <group>
                        <field name="progreso_ava" widget="progressbar"/>
                        <field name="tarea_terminada" widget="boolean_toggle"/>
                    </group>
                </group>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Bitacora" invisible="not es_tarea_obra">
                    <field name="bitacora_actividad_ids" readonly="1">
                        <list string="Avances de Bitacora">
                            <field name="bitacora_id"/>
                            <field name="name"/>
                            <field name="cantidad_avance"/>
                            <field name="cantidad_acumulada"/>
                            <field name="porcentaje_avance" widget="percentage"/>
                            <field name="importe_avance"/>
                            <field name="hora_inicio"/>
                            <field name="hora_termino"/>
                            <field name="licencia_om"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>
</odoo>
