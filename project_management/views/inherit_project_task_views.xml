<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="inherit_project_task_view_form" model="ir.ui.view">
        <field name="name">project.task.inherit.form</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='role_ids']" position="after">
                <field  name="es_tarea_obra" />
            </xpath>

            <xpath expr="//notebook" position="before">
                <group string="Datos Generales" invisible="not es_tarea_obra">
                    <group>
                        <field name="cliente" />
                    </group>

                    <group>
                        <field name="planta" widget="many2one_tags" />
                    </group>
                </group>
            </xpath>

        </field>
    </record>
</odoo>